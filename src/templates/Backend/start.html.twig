<div id="tl_buttons">
    <a href="{{ path('contao_backend') }}" class="header_back"
       title="{{ 'MSC.backBT'|trans([], 'contao_default') }}"
       accesskey="b">{{ 'MSC.backBT'|trans([], 'contao_default') }}</a>
</div>

{#
  Schritt-fuer-Schritt-Seite. Alle Texte stehen in languages/<Sprache>/chatbot_start.php; der Controller reicht sie als `t` herein.
  Einige enthalten einfaches HTML und werden mit |raw ausgegeben; dynamische Werte gehen als |e-escapte Platzhalter hinein.
  Pflicht sind die Schritte 1 bis 3 (`steps`); Schritt 4 und 5 sind optional.
#}
{% set current = not steps.connect ? 1 : (not steps.train ? 2 : (not steps.show ? 3 : 4)) %}
{% set allDone = doneCount == 3 %}
{% set total = modules.widget + modules.ask + modules.search %}

<div class="chatbot-start">

    {# ================================================================ Kopf #}
    <header class="cs-hero">
        <div class="cs-hero__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm7 11l.9 2.4L22 16l-2.1.6L19 19l-.9-2.4L16 16l2.1-.6L19 13zM5 14l.9 2.4L8 17l-2.1.6L5 20l-.9-2.4L2 17l2.1-.6L5 14z"/></svg>
        </div>
        <div class="cs-hero__text">
            <h2>{{ t.title }}</h2>
            <p>{{ t[allDone ? 'hero_lead_done' : 'hero_lead_todo'] }}</p>
            <p class="cs-hero__links">
                <a class="cs-hero__btn" href="https://chatbot.bluebranch.de/" target="_blank" rel="noopener">{{ t.portal }} &#8599;</a>
                <a class="cs-hero__link" href="https://chatbot.bluebranch.de/anleitung/contao" target="_blank" rel="noopener">{{ t.guide }} &#8599;</a>
            </p>
            {% if roots|length > 1 %}
            <form method="get" class="cs-hero__site">
                <input type="hidden" name="do" value="chatbot_start">
                <label for="chatbot-start-site">{{ t.website }}</label>
                <select id="chatbot-start-site" name="pageId" onchange="this.form.submit()">
                    {% for r in roots %}
                        <option value="{{ r.id }}"{{ r.id == root.id ? ' selected' : '' }}>{{ r.title }}</option>
                    {% endfor %}
                </select>
            </form>
            {% endif %}
        </div>
        <div class="cs-ring{{ allDone ? ' is-done' : '' }}" style="--p: {{ (doneCount / 3 * 100)|round }}" role="progressbar" aria-valuemin="0" aria-valuemax="3" aria-valuenow="{{ doneCount }}" aria-label="{{ t.progress }}">
            <span class="cs-ring__value">
                {% if allDone %}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}<strong>{{ doneCount }}</strong><small>{{ t.of3 }}</small>{% endif %}
            </span>
        </div>
    </header>

    {% if notice %}
    <div class="cs-notice cs-notice--{{ notice.type }}" role="status">
        <span class="cs-notice__icon" aria-hidden="true">{{ notice.type == 'ok' ? '✓' : '!' }}</span>
        <span>{{ notice.text }}</span>
    </div>
    {% endif %}

    {% if customTemplates %}
    {% set hasError = false %}{% for tpl in customTemplates %}{% if tpl.level == 'error' %}{% set hasError = true %}{% endif %}{% endfor %}
    <div class="cs-notice cs-notice--{{ hasError ? 'error' : 'warn' }}" role="status">
        <span class="cs-notice__icon" aria-hidden="true">!</span>
        <div>
            <strong>{{ t[hasError ? 'tpl_title_error' : 'tpl_title_info'] }}</strong>
            <p style="margin:4px 0 8px">{{ t.tpl_intro|raw }} {{ t[hasError ? 'tpl_fix_error' : 'tpl_fix_info']|raw }}</p>
            <ul class="cs-tpl">
                {% for tpl in customTemplates %}
                <li><code>{{ tpl.file }}</code> <span class="cs-pill {{ tpl.level == 'error' ? 'cs-pill--bad' : 'cs-pill--muted' }}">{{ t[tpl.level == 'error' ? 'tpl_badge_error' : 'tpl_badge_info'] }}</span>
                    <small>{% for m in tpl.messages %}{{ t['tpl_' ~ m] }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</small></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    <div class="cs-steps">

        {# ============================================================ 1 #}
        <section class="cs-step{{ steps.connect ? ' is-done' : '' }}{{ current == 1 ? ' is-current' : '' }}">
            <div class="cs-badge">{% if steps.connect %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}1{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>{{ t.s1_title }}</h3>
                    {% if steps.connect %}<span class="cs-pill cs-pill--ok">{{ t.pill_connected }}</span>{% elseif hasKey and connectionError %}<span class="cs-pill cs-pill--bad">{{ t.pill_error }}</span>{% else %}<span class="cs-pill">{{ t.pill_now }}</span>{% endif %}
                </div>

                {% if connected %}
                    <div class="cs-chips">
                        <span class="cs-chip"><small>{{ t.chip_plan }}</small><strong>{{ tier.label }}</strong></span>
                        {% if tier.requestsPerMonth is not null %}
                        <span class="cs-chip"><small>{{ t.chip_requests }}</small><strong>{{ tier.usedThisMonth|number_format(0, ',', '.') }} / {{ tier.requestsPerMonth|number_format(0, ',', '.') }}</strong></span>
                        {% endif %}
                        <span class="cs-chip"><small>{{ t.chip_voice }}</small><strong>{{ tier.transcriptionEnabled ? t.voice_up_to|replace({'%seconds%': tier.maxAudioSeconds}) : t.voice_none }}</strong></span>
                    </div>
                    <p class="cs-muted">{{ t.s1_saved_at|replace({'%title%': root.title|e})|raw }}</p>
                    <details class="cs-details">
                        <summary>{{ t.s1_other_key }}</summary>
                        {% include '@Chatbot/Backend/_start_key_form.html.twig' %}
                    </details>
                {% else %}
                    {% if hasKey and connectionError %}
                        <p class="cs-bad">{{ t.s1_retry|replace({'%message%': connectionError|e})|raw }}</p>
                    {% endif %}
                    <p>{{ t.s1_intro|raw }}</p>
                    {% include '@Chatbot/Backend/_start_key_form.html.twig' %}
                    <p class="cs-actions">
                        <a class="cs-btn cs-btn--ghost" href="https://chatbot.bluebranch.de/" target="_blank" rel="noopener">{{ t.s1_register }} &#8599;</a>
                    </p>
                {% endif %}
            </div>
        </section>

        {# ============================================================ 2 #}
        <section class="cs-step{{ steps.train ? ' is-done' : '' }}{{ current == 2 ? ' is-current' : '' }}{{ not steps.connect ? ' is-locked' : '' }}">
            <div class="cs-badge">{% if steps.train %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}2{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>{{ t.s2_title }}</h3>
                    {% if steps.train %}<span class="cs-pill cs-pill--ok">{{ t.pill_trained }}</span>{% elseif not steps.connect %}<span class="cs-pill cs-pill--muted">{{ t.pill_first }}</span>{% else %}<span class="cs-pill">{{ t.pill_now }}</span>{% endif %}
                </div>
                <p>{{ t.s2_intro|raw }}</p>
                {% if steps.train %}
                    <div class="cs-chips">
                        <span class="cs-chip"><small>{{ t.chip_pages }}</small><strong>{{ trainedPages }}</strong></span>
                        <span class="cs-chip"><small>{{ t.chip_extra }}</small><strong>{{ extraContent }}</strong></span>
                    </div>
                    <p class="cs-muted">{{ t.s2_auto }}</p>
                {% endif %}
                <div id="chatbot-train-progress" class="cs-progress" hidden aria-live="polite">
                    <div class="cs-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
                    <p id="chatbot-train-text" class="cs-muted"></p>
                </div>
                <p class="cs-actions">
                    <button type="button" id="chatbot-train" class="cs-btn{{ steps.train ? ' cs-btn--ghost' : '' }}"{{ not connected ? ' disabled' : '' }}>{{ t[steps.train ? 'train_new' : 'train_now'] }}</button>
                    {% if steps.train %}<button type="button" id="chatbot-train-all" class="cs-btn cs-btn--ghost"{{ not connected ? ' disabled' : '' }}>{{ t.train_all }}</button>{% endif %}
                    <a class="cs-link" href="{{ path('contao_backend', {do: 'chatbot_content'}) }}">{{ t.add_extra }}</a>
                </p>
                <p class="cs-muted">{{ t.s2_hint|replace({'%url%': path('contao_backend', {do: 'maintenance'})|e})|raw }}</p>
            </div>
        </section>

        {# ============================================================ 3 #}
        <section class="cs-step{{ steps.show ? ' is-done' : '' }}{{ current == 3 ? ' is-current' : '' }}{{ not steps.connect ? ' is-locked' : '' }}">
            <div class="cs-badge">{% if steps.show %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}3{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>{{ t.s3_title }}</h3>
                    {% if globalOn %}<span class="cs-pill cs-pill--ok">{{ t.pill_all_pages }}</span>{% elseif steps.show %}<span class="cs-pill cs-pill--ok">{{ t.pill_modules }}</span>{% elseif not steps.connect %}<span class="cs-pill cs-pill--muted">{{ t.pill_first }}</span>{% else %}<span class="cs-pill">{{ t.pill_now }}</span>{% endif %}
                </div>

                {% if globalOn %}
                    {% set modText = globalModule ? (' ' ~ t.s3_module|replace({'%name%': globalModule.name|e, '%id%': globalModule.id})|raw) : '' %}
                    <p>{{ t.s3_active|replace({'%module%': modText})|raw }}</p>
                    <form method="post" class="cs-actions">
                        <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                        <input type="hidden" name="pageId" value="{{ root.id }}">
                        <input type="hidden" name="action" value="widget_off">
                        <button type="submit" class="cs-btn cs-btn--ghost">{{ t.s3_off }}</button>
                        {% if globalModule %}
                        <a class="cs-link" href="{{ path('contao_backend', {do: 'themes', table: 'tl_module', act: 'edit', id: globalModule.id}) }}">{{ t.s3_edit_module }}</a>
                        {% endif %}
                    </form>
                {% else %}
                    <p>{{ t.s3_ask }}</p>
                    <div class="cs-choices">
                        <div class="cs-choice cs-choice--main">
                            <div class="cs-choice__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9S14.500 18.300 12 21c-2.500-2.700-3.800-5.700-3.800-9S9.500 5.700 12 3z"/></svg></div>
                            <strong>{{ t.s3_a_title }} <span class="cs-tag">{{ t.tag_recommended }}</span></strong>
                            <p>{{ t.s3_a_text }}</p>
                            <form method="post">
                                <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                                <input type="hidden" name="pageId" value="{{ root.id }}">
                                <input type="hidden" name="action" value="widget_on">
                                <button type="submit" class="cs-btn"{{ not connected ? ' disabled' : '' }}>{{ t.s3_a_button }}</button>
                            </form>
                        </div>
                        <div class="cs-choice">
                            <div class="cs-choice__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/></svg></div>
                            <strong>{{ t.s3_b_title }}</strong>
                            <p>{{ t.s3_b_text|replace({'%hint%': (total > 0 ? t.s3_b_have|replace({'%count%': total}) : t.s3_b_none)|e})|raw }}</p>
                            <a class="cs-btn cs-btn--ghost" href="{{ path('contao_backend', {do: 'themes', table: 'tl_module'}) }}">{{ t.s3_b_button }}</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

        {# ============================================================ 4 #}
        <section class="cs-step cs-step--optional{{ current == 4 ? ' is-current' : '' }}{{ not connected ? ' is-locked' : '' }}">
            <div class="cs-badge">4</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>{{ t.s4_title }}</h3>
                    <span class="cs-pill cs-pill--muted">{{ t.pill_optional }}</span>
                </div>
                <p>{{ t.s4_text }}</p>
                <form id="chatbot-start-test" class="cs-test" autocomplete="off">
                    <input type="text" id="chatbot-start-q" placeholder="{{ t.s4_placeholder }}" maxlength="500" aria-label="{{ t.s4_label }}"{{ not connected ? ' disabled' : '' }}>
                    <button type="submit" class="cs-btn"{{ not connected ? ' disabled' : '' }}>{{ t.s4_ask }}</button>
                </form>
                <div id="chatbot-start-answer" class="cs-answer" hidden aria-live="polite">
                    <div class="cs-answer__avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2z"/></svg></div>
                    <div class="cs-answer__body">
                        <div id="chatbot-start-answer-text" class="cs-answer__text"></div>
                        <ul id="chatbot-start-sources" class="cs-sources"></ul>
                    </div>
                </div>
                <p class="cs-actions">
                    <a class="cs-btn cs-btn--ghost" href="{{ siteUrl }}" target="_blank" rel="noopener">{{ t.open_site }} &#8599;</a>
                </p>
            </div>
        </section>

        {# ============================================================ 5 #}
        <section class="cs-step cs-step--optional">
            <div class="cs-badge">5</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>{{ t.s5_title }}</h3>
                    <span class="cs-pill cs-pill--muted">{{ t.pill_optional }}</span>
                </div>
                <form method="post">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                    <input type="hidden" name="pageId" value="{{ root.id }}">
                    <input type="hidden" name="action" value="defaults">
                    <label class="cs-switch">
                        <input type="checkbox" name="voice" value="1"{{ voiceDefault ? ' checked' : '' }}>
                        <span class="cs-switch__track" aria-hidden="true"></span>
                        <span class="cs-switch__text"><strong>{{ t.s5_voice_t }}</strong>{{ t.s5_voice_d }}</span>
                    </label>
                    <label class="cs-switch">
                        <input type="checkbox" name="feedback" value="1"{{ feedbackDefault ? ' checked' : '' }}>
                        <span class="cs-switch__track" aria-hidden="true"></span>
                        <span class="cs-switch__text"><strong>{{ t.s5_fb_t }}</strong>{{ t.s5_fb_d }}</span>
                    </label>
                    <p class="cs-actions"><button type="submit" class="cs-btn cs-btn--ghost">{{ t.s5_save }}</button></p>
                </form>
                <p class="cs-muted cs-links">{{ t.s5_links|replace({'%settings%': path('contao_backend', {do: 'settings'})|e, '%log%': path('contao_backend', {do: 'chatbot_log'})|e, '%trained%': path('contao_backend', {do: 'chatbot_trained_content'})|e})|raw }}</p>
            </div>
        </section>

    </div>
</div>

{% set js = {
    running: t.js_running,
    progress: t.js_progress|replace({'%pos%': '{pos}', '%total%': '{total}'}),
    unreachable: t.js_unreachable|replace({'%failed%': '{failed}'}),
    none: t.js_none,
    failAll: t.js_fail_all|replace({'%detail%': '{detail}'}),
    done: t.js_done|replace({'%ok%': '{ok}', '%failed%': '{failed}'}),
    trainFailed: t.js_train_failed|replace({'%message%': '{message}'}),
    answering: t.js_answering,
    noAnswer: t.js_no_answer,
    requestFailed: t.js_request_failed,
} %}
<script>
(function () {
    const L = {{ js|json_encode|raw }};
    const fill_ = function (template, values) { return template.replace(/\{(\w+)\}/g, function (m, k) { return values[k] !== undefined ? values[k] : m; }); };

    const start = document.getElementById('chatbot-train');
    if (!start) return;

    const all = document.getElementById('chatbot-train-all');
    const box = document.getElementById('chatbot-train-progress');
    const bar = box.querySelector('.cs-progress__bar');
    const fill = bar.querySelector('span');
    const text = document.getElementById('chatbot-train-text');
    const url = {{ trainUrl|json_encode|raw }};
    const token = {{ streamToken|json_encode|raw }};
    const pageId = {{ root.id }};
    let busy = false;

    function show(message, percent) {
        box.hidden = false;
        text.textContent = message;
        if (percent !== null) {
            fill.style.width = percent + '%';
            bar.setAttribute('aria-valuenow', String(Math.round(percent)));
        }
    }

    async function run(reset) {
        if (busy) return;
        busy = true;
        [start, all].forEach(function (b) { if (b) b.disabled = true; });
        show(L.running, 0);

        let runId = '';
        try {
            for (;;) {
                const response = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-Stream-Token': token },
                    body: JSON.stringify({ pageId: pageId, runId: runId, reset: reset && runId === '' }),
                });
                const data = await response.json().catch(function () { return {}; });

                if (!response.ok || !data.success) {
                    throw new Error(data.message || ('HTTP ' + response.status));
                }

                runId = data.runId;
                const percent = data.total > 0 ? data.pos / data.total * 100 : 100;
                show(fill_(L.progress, { pos: data.pos, total: data.total }) + (data.failed ? fill_(L.unreachable, { failed: data.failed }) : ''), percent);

                if (data.done) {
                    if (data.total === 0) {
                        show(L.none, 100);
                    } else if (data.ok === 0) {
                        show(fill_(L.failAll, { detail: data.lastError ? ': ' + data.lastError : '' }), 100);
                    } else {
                        show(fill_(L.done, { ok: data.ok, failed: data.failed ? ', ' + fill_(L.unreachable, { failed: data.failed }).trim() + (data.lastError ? ' [' + data.lastError + ']' : '') : '' }), 100);
                        setTimeout(function () { window.location.reload(); }, 6000);
                    }
                    break;
                }
            }
        } catch (error) {
            show(fill_(L.trainFailed, { message: error.message }), null);
        } finally {
            busy = false;
            [start, all].forEach(function (b) { if (b) b.disabled = false; });
        }
    }

    start.addEventListener('click', function () { run(false); });
    if (all) all.addEventListener('click', function () { run(true); });
})();
</script>

<script src="{{ assets.marked }}"></script>
<script src="{{ assets.common }}"></script>
<script>
(function () {
    const L = {{ js|json_encode|raw }};
    const form = document.getElementById('chatbot-start-test');
    if (!form || !window.ChatbotStream) return;

    const input = document.getElementById('chatbot-start-q');
    const box = document.getElementById('chatbot-start-answer');
    const text = document.getElementById('chatbot-start-answer-text');
    const list = document.getElementById('chatbot-start-sources');
    const button = form.querySelector('button');
    let stream = null;

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        const question = input.value.trim();
        if (!question) return;

        if (stream) stream.close();
        let answer = '';
        let sources = [];
        box.hidden = false;
        text.innerHTML = '';
        const waiting = document.createElement('em');
        waiting.textContent = L.answering;
        text.appendChild(waiting);
        list.innerHTML = '';
        button.disabled = true;

        const finish = function () { button.disabled = false; };

        stream = ChatbotStream.open({{ streamUrl|json_encode|raw }}, {
            token: {{ streamToken|json_encode|raw }},
            body: { prompt: question, language: {{ root.language|json_encode|raw }}, pageId: {{ root.id }} },
            handlers: {
                message: function (e) {
                    try {
                        const data = JSON.parse(e.data);
                        if (data.answer) {
                            answer += data.answer;
                            text.innerHTML = ChatbotMarkdown.toHtml(answer);
                        }
                        if (data.sources) sources = data.sources;
                    } catch (err) { /* unvollstaendiger Block */ }
                },
                end: function () {
                    if (!answer) text.textContent = L.noAnswer;
                    list.innerHTML = '';
                    ChatbotSources.linkable(sources).slice(0, 3).forEach(function (s) {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.href = s.url; a.textContent = s.title || s.url; a.target = '_blank'; a.rel = 'noopener';
                        li.appendChild(a); list.appendChild(li);
                    });
                    finish();
                },
                error: function (e) {
                    let message = L.requestFailed;
                    try { const d = JSON.parse(e.data); if (d.message) message = d.message; } catch (err) { /* ohne Rumpf */ }
                    text.textContent = message;
                    finish();
                }
            }
        });
    });
})();
</script>

<style>
    /*
     * Farben ueber Contaos Backend-Variablen (--text, --content-bg, ...): Sie wechseln im Dark-Mode
     * mit. Getoente Flaechen sind halbtransparent, damit sie auf hellem und dunklem Grund stimmen.
     */
    .chatbot-start {
        --cs-accent: #2563eb;
        --cs-accent-dark: #4338ca;
        --cs-ok: #16a34a;
        --cs-bad: #dc2626;
        --cs-text: var(--text, #1f2430);
        --cs-muted: var(--gray, #6b7280);
        --cs-border: var(--content-border, #e3e6ec);
        --cs-card: var(--content-bg, #ffffff);
        --cs-subtle: var(--table-header, #f6f7f9);
        --cs-ring: rgba(37, 99, 235, .28);
        box-sizing: border-box;
        max-width: 1120px;
        margin: 0 auto;
        padding: 14px 36px 64px;
        color: var(--cs-text);
        line-height: 1.55;
    }
    .chatbot-start *, .chatbot-start *::before, .chatbot-start *::after { box-sizing: border-box; }
    .chatbot-start p { margin: 0 0 12px; }
    .chatbot-start h2, .chatbot-start h3 { margin: 0; font-weight: 700; letter-spacing: -.01em; }
    .chatbot-start a { text-underline-offset: 3px; }

    /* ------------------------------------------------------------ Kopf */
    .cs-hero {
        display: flex; align-items: center; gap: 22px;
        padding: 26px 30px; margin-bottom: 22px; border-radius: 20px; color: #fff;
        background: linear-gradient(120deg, var(--cs-accent) 0%, var(--cs-accent-dark) 100%);
        box-shadow: 0 14px 34px rgba(67, 56, 202, .28);
        position: relative; overflow: hidden;
    }
    .cs-hero::after {
        content: ""; position: absolute; right: -60px; top: -80px; width: 260px; height: 260px; border-radius: 50%;
