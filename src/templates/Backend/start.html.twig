<div id="tl_buttons">
    <a href="{{ path('contao_backend') }}" class="header_back"
       title="{{ 'MSC.backBT'|trans([], 'contao_default') }}"
       accesskey="b">{{ 'MSC.backBT'|trans([], 'contao_default') }}</a>
</div>

{#
  Schritt-fuer-Schritt-Seite. Alles hier laeuft durch Twigs Autoescape, kein |raw (ausser json_encode
  fuer Skriptwerte). Pflicht sind die Schritte 1 bis 3 (`steps`); Schritt 4 und 5 sind optional.
#}
{% set current = not steps.connect ? 1 : (not steps.train ? 2 : (not steps.show ? 3 : 4)) %}
{% set allDone = doneCount == 3 %}

<div class="chatbot-start">

    {# ================================================================ Kopf #}
    <header class="cs-hero">
        <div class="cs-hero__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm7 11l.9 2.4L22 16l-2.1.6L19 19l-.9-2.4L16 16l2.1-.6L19 13zM5 14l.9 2.4L8 17l-2.1.6L5 20l-.9-2.4L2 17l2.1-.6L5 14z"/></svg>
        </div>
        <div class="cs-hero__text">
            <h2>Erste Schritte</h2>
            <p>
                {% if allDone %}
                    Alles eingerichtet &ndash; Ihr Chatbot läuft. Probieren Sie ihn aus oder passen Sie die Voreinstellungen an.
                {% else %}
                    In drei Schritten zum laufenden Chatbot: Zugang verbinden, Inhalte trainieren, Chat anzeigen.
                {% endif %}
            </p>
            {% if roots|length > 1 %}
            <form method="get" class="cs-hero__site">
                <input type="hidden" name="do" value="chatbot_start">
                <label for="chatbot-start-site">Website</label>
                <select id="chatbot-start-site" name="pageId" onchange="this.form.submit()">
                    {% for r in roots %}
                        <option value="{{ r.id }}"{{ r.id == root.id ? ' selected' : '' }}>{{ r.title }}</option>
                    {% endfor %}
                </select>
            </form>
            {% endif %}
        </div>
        <div class="cs-ring{{ allDone ? ' is-done' : '' }}" style="--p: {{ (doneCount / 3 * 100)|round }}" role="progressbar" aria-valuemin="0" aria-valuemax="3" aria-valuenow="{{ doneCount }}" aria-label="Fortschritt">
            <span class="cs-ring__value">
                {% if allDone %}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}<strong>{{ doneCount }}</strong><small>von 3</small>{% endif %}
            </span>
        </div>
    </header>

    {% if notice %}
    <div class="cs-notice cs-notice--{{ notice.type }}" role="status">
        <span class="cs-notice__icon" aria-hidden="true">{{ notice.type == 'ok' ? '✓' : '!' }}</span>
        <span>{{ notice.text }}</span>
    </div>
    {% endif %}

    {% if customTemplates %}
    {% set hasError = false %}{% for t in customTemplates %}{% if t.level == 'error' %}{% set hasError = true %}{% endif %}{% endfor %}
    <div class="cs-notice cs-notice--{{ hasError ? 'error' : 'warn' }}" role="status">
        <span class="cs-notice__icon" aria-hidden="true">!</span>
        <div>
            <strong>{{ hasError ? 'Angepasste Templates sind zu alt' : 'Angepasste Templates im Projekt' }}</strong>
            <p style="margin:4px 0 8px">Diese Dateien im Ordner <code>templates/</code> ersetzen die der Erweiterung und werden bei Updates nicht mitgezogen.
                {% if hasError %}Mindestens eine bricht den Chat. Am einfachsten: die Datei löschen (dann gilt das Template der Erweiterung) oder neu aus <code>vendor/bluebranch/chatbot/src/Resources/contao/templates/</code> kopieren und anpassen.{% else %}Der Chat funktioniert, es fehlen neuere Funktionen. Zum Nachziehen die Datei löschen oder neu aus <code>vendor/bluebranch/chatbot/src/Resources/contao/templates/</code> kopieren.{% endif %}</p>
            <ul class="cs-tpl">
                {% for t in customTemplates %}
                <li><code>{{ t.file }}</code> <span class="cs-pill {{ t.level == 'error' ? 'cs-pill--bad' : 'cs-pill--muted' }}">{{ t.level == 'error' ? 'bricht den Chat' : 'veraltet' }}</span>
                    <small>{{ t.messages|join(' · ') }}</small></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    <div class="cs-steps">

        {# ============================================================ 1 #}
        <section class="cs-step{{ steps.connect ? ' is-done' : '' }}{{ current == 1 ? ' is-current' : '' }}">
            <div class="cs-badge">{% if steps.connect %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}1{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>Zugang verbinden</h3>
                    {% if steps.connect %}<span class="cs-pill cs-pill--ok">Verbunden</span>{% elseif hasKey and connectionError %}<span class="cs-pill cs-pill--bad">Fehler</span>{% else %}<span class="cs-pill">Jetzt dran</span>{% endif %}
                </div>

                {% if connected %}
                    <div class="cs-chips">
                        <span class="cs-chip"><small>Tarif</small><strong>{{ tier.label }}</strong></span>
                        {% if tier.requestsPerMonth is not null %}
                        <span class="cs-chip"><small>Anfragen im Monat</small><strong>{{ tier.usedThisMonth|number_format(0, ',', '.') }} / {{ tier.requestsPerMonth|number_format(0, ',', '.') }}</strong></span>
                        {% endif %}
                        <span class="cs-chip"><small>Spracheingabe</small><strong>{{ tier.transcriptionEnabled ? 'bis ' ~ tier.maxAudioSeconds ~ ' s' : 'nicht verfügbar' }}</strong></span>
                    </div>
                    <p class="cs-muted">Der Key ist bei „{{ root.title }}“ im Seitenbaum gespeichert.</p>
                    <details class="cs-details">
                        <summary>Anderen Key eintragen</summary>
                        {% include '@Chatbot/Backend/_start_key_form.html.twig' %}
                    </details>
                {% else %}
                    {% if hasKey and connectionError %}
                        <p class="cs-bad">{{ connectionError }} Tragen Sie den Key unten noch einmal ein, wenn er sich geändert hat.</p>
                    {% endif %}
                    <p>Damit der Chatbot antworten kann, braucht Ihre Website einen Zugang. Die Registrierung ist kostenlos und dauert eine Minute &ndash; erstellen Sie dort einen <strong>API-Key</strong> und fügen Sie ihn hier ein.</p>
                    {% include '@Chatbot/Backend/_start_key_form.html.twig' %}
                    <p class="cs-actions">
                        <a class="cs-btn cs-btn--ghost" href="https://chatbot.bluebranch.de/" target="_blank" rel="noopener">Kostenlos registrieren &#8599;</a>
                    </p>
                {% endif %}
            </div>
        </section>

        {# ============================================================ 2 #}
        <section class="cs-step{{ steps.train ? ' is-done' : '' }}{{ current == 2 ? ' is-current' : '' }}{{ not steps.connect ? ' is-locked' : '' }}">
            <div class="cs-badge">{% if steps.train %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}2{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>Inhalte trainieren</h3>
                    {% if steps.train %}<span class="cs-pill cs-pill--ok">Trainiert</span>{% elseif not steps.connect %}<span class="cs-pill cs-pill--muted">Zuerst Schritt 1</span>{% else %}<span class="cs-pill">Jetzt dran</span>{% endif %}
                </div>
                <p>
                    Der Chatbot antwortet nur aus Ihren eigenen Seiten. Dafür liest Contao Ihre Inhalte beim Aufbau des
                    <strong>Suchindex</strong> und übergibt sie an den Chatbot.
                </p>
                {% if steps.train %}
                    <div class="cs-chips">
                        <span class="cs-chip"><small>Seiten</small><strong>{{ trainedPages }}</strong></span>
                        <span class="cs-chip"><small>Zusatzinhalte</small><strong>{{ extraContent }}</strong></span>
                    </div>
                    <p class="cs-muted">Neue und geänderte Seiten werden bei ihrem nächsten Aufruf automatisch ergänzt.</p>
                {% else %}
                    <ol class="cs-list">
                        <li>Öffnen Sie <strong>System → Wartung</strong> und wählen Sie <em>Suchindex neu aufbauen</em>.</li>
                        <li>Starten Sie den Vorgang und warten Sie, bis er fertig ist.</li>
                        <li>Kommen Sie hierher zurück &ndash; der Stand aktualisiert sich beim Laden der Seite.</li>
                    </ol>
                {% endif %}
                <p class="cs-actions">
                    <a class="cs-btn{{ steps.train ? ' cs-btn--ghost' : '' }}" href="{{ path('contao_backend', {do: 'maintenance'}) }}">Wartung öffnen</a>
                    <a class="cs-btn cs-btn--ghost" href="{{ path('contao_backend', {do: 'chatbot_start', pageId: root.id}) }}">Stand aktualisieren</a>
                    <a class="cs-link" href="{{ path('contao_backend', {do: 'chatbot_content'}) }}">Zusatzinhalte (PDF, Word, Text) hinzufügen</a>
                </p>
            </div>
        </section>

        {# ============================================================ 3 #}
        <section class="cs-step{{ steps.show ? ' is-done' : '' }}{{ current == 3 ? ' is-current' : '' }}{{ not steps.connect ? ' is-locked' : '' }}">
            <div class="cs-badge">{% if steps.show %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{% else %}3{% endif %}</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>Chat auf der Website anzeigen</h3>
                    {% if globalOn %}<span class="cs-pill cs-pill--ok">Auf allen Seiten</span>{% elseif steps.show %}<span class="cs-pill cs-pill--ok">Module vorhanden</span>{% elseif not steps.connect %}<span class="cs-pill cs-pill--muted">Zuerst Schritt 1</span>{% else %}<span class="cs-pill">Jetzt dran</span>{% endif %}
                </div>

                {% if globalOn %}
                    <p>
                        Der Chat erscheint auf <strong>allen Seiten</strong>{% if globalModule %} (Modul „{{ globalModule.name }}“, ID {{ globalModule.id }}){% endif %}.
                        Einzelne Seiten nehmen Sie in den Seiteneinstellungen mit <em>Chat auf dieser Seite ausblenden</em> aus.
                    </p>
                    <form method="post" class="cs-actions">
                        <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                        <input type="hidden" name="pageId" value="{{ root.id }}">
                        <input type="hidden" name="action" value="widget_off">
                        <button type="submit" class="cs-btn cs-btn--ghost">Nicht mehr automatisch anzeigen</button>
                        {% if globalModule %}
                        <a class="cs-link" href="{{ path('contao_backend', {do: 'themes', table: 'tl_module', act: 'edit', id: globalModule.id}) }}">Aussehen und Texte im Modul ändern</a>
                        {% endif %}
                    </form>
                {% else %}
                    <p>Wie soll der Chat erscheinen?</p>
                    <div class="cs-choices">
                        <div class="cs-choice cs-choice--main">
                            <div class="cs-choice__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9S14.500 18.300 12 21c-2.500-2.700-3.800-5.700-3.800-9S9.500 5.700 12 3z"/></svg></div>
                            <strong>Auf allen Seiten <span class="cs-tag">empfohlen</span></strong>
                            <p>Ein Klick &ndash; kein Modul, kein Layout. Das Chat-Symbol erscheint unten rechts auf jeder Seite.</p>
                            <form method="post">
                                <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                                <input type="hidden" name="pageId" value="{{ root.id }}">
                                <input type="hidden" name="action" value="widget_on">
                                <button type="submit" class="cs-btn"{{ not connected ? ' disabled' : '' }}>Chat auf allen Seiten anzeigen</button>
                            </form>
                        </div>
                        <div class="cs-choice">
                            <div class="cs-choice__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/></svg></div>
                            <strong>Selbst platzieren</strong>
                            <p>
                                Für mehr Kontrolle: Binden Sie das Modul <em>Chatbot Widget</em>, <em>Chatbot Frage</em> oder
                                <em>Chatbot KI-Suche</em> in ein Layout oder einen Artikel ein
                                {% if modules.widget + modules.ask + modules.search > 0 %}
                                    (es gibt bereits {{ modules.widget + modules.ask + modules.search }} {{ modules.widget + modules.ask + modules.search == 1 ? 'Modul' : 'Module' }}).
                                {% else %}
                                    (Layout → Module, oder Inhaltselement „Modul“).
                                {% endif %}
                            </p>
                            <a class="cs-btn cs-btn--ghost" href="{{ path('contao_backend', {do: 'themes', table: 'tl_module'}) }}">Module öffnen</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

        {# ============================================================ 4 #}
        <section class="cs-step cs-step--optional{{ current == 4 ? ' is-current' : '' }}{{ not connected ? ' is-locked' : '' }}">
            <div class="cs-badge">4</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>Ausprobieren</h3>
                    <span class="cs-pill cs-pill--muted">optional</span>
                </div>
                <p>Stellen Sie dem Chatbot eine Frage zu Ihrer Website &ndash; so wie ein Besucher es täte.</p>
                <form id="chatbot-start-test" class="cs-test" autocomplete="off">
                    <input type="text" id="chatbot-start-q" placeholder="z. B. Welche Leistungen bieten Sie an?" maxlength="500" aria-label="Testfrage"{{ not connected ? ' disabled' : '' }}>
                    <button type="submit" class="cs-btn"{{ not connected ? ' disabled' : '' }}>Fragen</button>
                </form>
                <div id="chatbot-start-answer" class="cs-answer" hidden aria-live="polite">
                    <div class="cs-answer__avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2z"/></svg></div>
                    <div class="cs-answer__body">
                        <div id="chatbot-start-answer-text" class="cs-answer__text"></div>
                        <ul id="chatbot-start-sources" class="cs-sources"></ul>
                    </div>
                </div>
                <p class="cs-actions">
                    <a class="cs-btn cs-btn--ghost" href="{{ siteUrl }}" target="_blank" rel="noopener">Website öffnen &#8599;</a>
                </p>
            </div>
        </section>

        {# ============================================================ 5 #}
        <section class="cs-step cs-step--optional">
            <div class="cs-badge">5</div>
            <div class="cs-card">
                <div class="cs-card__head">
                    <h3>Feinschliff</h3>
                    <span class="cs-pill cs-pill--muted">optional</span>
                </div>
                <form method="post">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
                    <input type="hidden" name="pageId" value="{{ root.id }}">
                    <input type="hidden" name="action" value="defaults">
                    <label class="cs-switch">
                        <input type="checkbox" name="voice" value="1"{{ voiceDefault ? ' checked' : '' }}>
                        <span class="cs-switch__track" aria-hidden="true"></span>
                        <span class="cs-switch__text"><strong>Spracheingabe anbieten</strong>Besucher können ihre Frage sprechen (Mikrofon-Knopf). Die Aufnahme wird nicht gespeichert. Bitte in der Datenschutzerklärung erwähnen.</span>
                    </label>
                    <label class="cs-switch">
                        <input type="checkbox" name="feedback" value="1"{{ feedbackDefault ? ' checked' : '' }}>
                        <span class="cs-switch__track" aria-hidden="true"></span>
                        <span class="cs-switch__text"><strong>Feedback abfragen</strong>Daumen hoch/runter unter jeder Antwort; die bewertete Frage wird im Backend unter „Fragen &amp; Feedback“ gespeichert.</span>
                    </label>
                    <p class="cs-actions"><button type="submit" class="cs-btn cs-btn--ghost">Voreinstellungen speichern</button></p>
                </form>
                <p class="cs-muted cs-links">
                    Name, Farbe, Symbol und Begrüßung stellen Sie unter
                    <a href="{{ path('contao_backend', {do: 'settings'}) }}">System → Einstellungen</a> ein. Weiter geht es mit
                    <a href="{{ path('contao_backend', {do: 'chatbot_log'}) }}">Fragen &amp; Feedback</a> und
                    <a href="{{ path('contao_backend', {do: 'chatbot_trained_content'}) }}">Trainierte Seiten</a>;
                    die Anleitung steht unter <a href="https://chatbot.bluebranch.de/anleitung/contao" target="_blank" rel="noopener">chatbot.bluebranch.de</a>.
                </p>
            </div>
        </section>

    </div>
</div>

<script src="{{ assets.marked }}"></script>
<script src="{{ assets.common }}"></script>
<script>
(function () {
    const form = document.getElementById('chatbot-start-test');
    if (!form || !window.ChatbotStream) return;

    const input = document.getElementById('chatbot-start-q');
    const box = document.getElementById('chatbot-start-answer');
    const text = document.getElementById('chatbot-start-answer-text');
    const list = document.getElementById('chatbot-start-sources');
    const button = form.querySelector('button');
    let stream = null;

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        const question = input.value.trim();
        if (!question) return;

        if (stream) stream.close();
        let answer = '';
        let sources = [];
        box.hidden = false;
        text.innerHTML = '<em>Antwort wird erzeugt …</em>';
        list.innerHTML = '';
        button.disabled = true;

        const finish = function () { button.disabled = false; };

        stream = ChatbotStream.open({{ streamUrl|json_encode|raw }}, {
            token: {{ streamToken|json_encode|raw }},
            body: { prompt: question, language: {{ root.language|json_encode|raw }}, pageId: {{ root.id }} },
            handlers: {
                message: function (e) {
                    try {
                        const data = JSON.parse(e.data);
                        if (data.answer) {
                            answer += data.answer;
                            text.innerHTML = ChatbotMarkdown.toHtml(answer);
                        }
                        if (data.sources) sources = data.sources;
                    } catch (err) { /* unvollstaendiger Block */ }
                },
                end: function () {
                    if (!answer) text.textContent = 'Es kam keine Antwort. Wurde der Suchindex schon aufgebaut?';
                    list.innerHTML = '';
                    ChatbotSources.linkable(sources).slice(0, 3).forEach(function (s) {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.href = s.url; a.textContent = s.title || s.url; a.target = '_blank'; a.rel = 'noopener';
                        li.appendChild(a); list.appendChild(li);
                    });
                    finish();
                },
                error: function (e) {
                    let message = 'Die Anfrage ist fehlgeschlagen.';
                    try { const d = JSON.parse(e.data); if (d.message) message = d.message; } catch (err) { /* ohne Rumpf */ }
                    text.textContent = message;
                    finish();
                }
            }
        });
    });
})();
</script>

<style>
    /*
     * Farben ueber Contaos Backend-Variablen (--text, --content-bg, ...): Sie wechseln im Dark-Mode
     * mit. Getoente Flaechen sind halbtransparent, damit sie auf hellem und dunklem Grund stimmen.
     */
    .chatbot-start {
        --cs-accent: #2563eb;
        --cs-accent-dark: #4338ca;
        --cs-ok: #16a34a;
        --cs-bad: #dc2626;
        --cs-text: var(--text, #1f2430);
        --cs-muted: var(--gray, #6b7280);
        --cs-border: var(--content-border, #e3e6ec);
        --cs-card: var(--content-bg, #ffffff);
        --cs-subtle: var(--table-header, #f6f7f9);
        --cs-ring: rgba(37, 99, 235, .28);
        box-sizing: border-box;
        max-width: 1120px;
        margin: 0 auto;
        padding: 14px 36px 64px;
        color: var(--cs-text);
        line-height: 1.55;
    }
    .chatbot-start *, .chatbot-start *::before, .chatbot-start *::after { box-sizing: border-box; }
    .chatbot-start p { margin: 0 0 12px; }
    .chatbot-start h2, .chatbot-start h3 { margin: 0; font-weight: 700; letter-spacing: -.01em; }
    .chatbot-start a { text-underline-offset: 3px; }

    /* ------------------------------------------------------------ Kopf */
    .cs-hero {
        display: flex; align-items: center; gap: 22px;
        padding: 26px 30px; margin-bottom: 22px; border-radius: 20px; color: #fff;
        background: linear-gradient(120deg, var(--cs-accent) 0%, var(--cs-accent-dark) 100%);
        box-shadow: 0 14px 34px rgba(67, 56, 202, .28);
        position: relative; overflow: hidden;
    }
    .cs-hero::after {
        content: ""; position: absolute; right: -60px; top: -80px; width: 260px; height: 260px; border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,.22), transparent 70%); pointer-events: none;
    }
    .cs-hero__icon {
        flex: 0 0 60px; height: 60px; border-radius: 18px; display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.18); box-shadow: inset 0 0 0 1px rgba(255,255,255,.28);
    }
    .cs-hero__text { flex: 1 1 auto; min-width: 0; position: relative; z-index: 1; }
    .cs-hero h2 { font-size: 1.75rem; color: #fff; }
    .cs-hero p { margin: 6px 0 0; color: rgba(255,255,255,.88); font-size: 1.02rem; }
    .cs-hero__site { margin: 14px 0 0 !important; display: flex; align-items: center; gap: 10px; }
    .cs-hero__site label { font-size: .85rem; color: rgba(255,255,255,.85); }
    .cs-hero__site select { border-radius: 8px; border: 0; padding: 6px 10px; font: inherit; max-width: 100%; }

    .cs-ring {
        --p: 0; flex: 0 0 92px; height: 92px; border-radius: 50%; position: relative; z-index: 1;
        background: conic-gradient(#fff calc(var(--p) * 1%), rgba(255,255,255,.25) 0);
        display: flex; align-items: center; justify-content: center;
    }
    .cs-ring::before { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: var(--cs-accent-dark); }
    .cs-ring__value { position: relative; display: flex; flex-direction: column; align-items: center; line-height: 1.05; color: #fff; }
    .cs-ring__value strong { font-size: 1.9rem; }
    .cs-ring__value small { font-size: .72rem; opacity: .85; }
    .cs-ring.is-done { background: #fff; }
    .cs-ring.is-done::before { background: #16a34a; }

    /* ------------------------------------------------------------ Hinweis */
    .cs-notice {
        display: flex; gap: 12px; align-items: flex-start; padding: 14px 18px; margin-bottom: 20px; border-radius: 14px;
        border: 1px solid; font-size: .98rem;
    }
    .cs-notice__icon { flex: 0 0 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; font-size: .85rem; }
    .cs-notice--ok { background: rgba(22,163,74,.1); border-color: rgba(22,163,74,.35); }
    .cs-notice--ok .cs-notice__icon { background: var(--cs-ok); }
    .cs-notice--error { background: rgba(220,38,38,.09); border-color: rgba(220,38,38,.35); }
    .cs-notice--error .cs-notice__icon { background: var(--cs-bad); }
