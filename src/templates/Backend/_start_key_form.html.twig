<form method="post" class="cs-key" autocomplete="off">
    <input type="hidden" name="REQUEST_TOKEN" value="{{ requestToken }}">
    <input type="hidden" name="pageId" value="{{ root.id }}">
    <input type="hidden" name="action" value="save_key">
    <input type="password" name="api_key" placeholder="{{ t.key_placeholder }}" required minlength="16" maxlength="200" autocomplete="off" spellcheck="false" aria-label="{{ t.key_placeholder }}">
    <button type="submit" class="cs-btn">{{ t.key_submit }}</button>
</form>
