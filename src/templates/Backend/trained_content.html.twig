        margin-bottom: 20px;
    }

    .chatbot-admin__title {
        margin: 0 0 4px;
        font-size: 1.4rem;
    }

    .chatbot-admin__subtitle {
        margin: 0;
        color: var(--chatbot-admin-muted);
        font-size: 0.9rem;
    }

    .chatbot-admin__notice {
