<!-- indexer::stop -->
<?php if (!$this->unstyled): ?><link rel="stylesheet" href="<?= \Bluebranch\Chatbot\classes\Asset::url('css/chatbot.css') ?>"><?php endif; ?>
<div class="chatbot-generate-search-container chatbot-generate-search-container--full" id="chatbot-search-<?= $this->id ?>"<?php if ($this->accentStyle): ?> style="<?= \Contao\StringUtil::specialchars($this->accentStyle) ?>"<?php endif; ?>>
    <?php if ($this->headline): ?>
    <<?= $this->hl ?> class="headline"><?= $this->headline ?></<?= $this->hl ?>>
<?php endif; ?>

    <form class="chatbot-search-form" method="get">
        <div class="widget widget-text">
            <label for="ctrl_chatbot_keywords_<?= $this->id ?>" class="invisible"><?= $GLOBALS['TL_LANG']['MSC']['keywords'] ?></label>
            <input type="search" name="<?= $this->queryParam ?>" id="ctrl_chatbot_keywords_<?= $this->id ?>" class="text chatbot-ask-input" value="<?= \Contao\StringUtil::specialchars($this->query) ?>">
            <?php if ($this->voice): ?>
            <button type="button" class="chatbot-voice-btn" aria-label="<?= $this->labelVoice ?>" title="<?= $this->labelVoice ?>" hidden>
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 15a3.5 3.5 0 0 0 3.5-3.5v-6a3.5 3.5 0 0 0-7 0v6A3.5 3.5 0 0 0 12 15Zm6-3.5a1 1 0 1 0-2 0 4 4 0 0 1-8 0 1 1 0 1 0-2 0 6 6 0 0 0 5 5.91V20H9a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2h-2v-2.59A6 6 0 0 0 18 11.5Z"/></svg>
            </button>
            <?php endif; ?>
        </div>
        <div class="widget widget-submit">
            <button type="submit" class="submit"><?= $GLOBALS['TL_LANG']['MSC']['searchLabel'] ?></button>
        </div>
    </form>

<?php if (!$this->hasApiKey): ?>
    <?php if ($this->showConfigHint): ?>
    <div class="chatbot-error-message" style="background: #f8d7da; color: #721c24; padding: 15px; border: 1px solid #f5c6cb; border-radius: 4px; margin-bottom: 20px;">
        <strong>Hinweis:</strong> Der Chatbot ist derzeit nicht konfiguriert (API-Key fehlt).
    </div>
    <?php endif; ?>
<?php elseif ($this->query): ?>
    <div class="chatbot-response">
        <div class="chatbot-loading" style="display:none;">Antwort wird generiert...</div>
        <div class="chatbot-content"></div>
        <div class="chatbot-sources" style="display:none;">
            <p><strong><?= $this->labelSources ?></strong></p>
            <ul></ul>
        </div>
    </div>
<?php endif; ?>

<?php if ($this->query): ?>
    <div class="chatbot-native-results">
        <?php if ($this->searchResultsCount > 0): ?>
        <p class="chatbot-native-results__header"><?= vsprintf($GLOBALS['TL_LANG']['MSC']['sResults'], [1, \count($this->searchResults), $this->searchResultsCount, \Contao\StringUtil::specialchars($this->query)]) ?></p>
        <ul class="chatbot-native-results__list">
            <?php foreach ($this->searchResults as $result): ?>
            <li class="chatbot-native-results__item">
                <h3 class="chatbot-native-results__title"><a href="<?= $result['href'] ?>"><?= $result['title'] ?></a></h3>
                <?php if ($result['context']): ?><p class="chatbot-native-results__context"><?= $result['context'] ?></p><?php endif; ?>
                <p class="chatbot-native-results__url"><?= $result['url'] ?></p>
            </li>
            <?php endforeach; ?>
        </ul>
        <?php else: ?>
        <p class="chatbot-native-results__empty"><?= sprintf($GLOBALS['TL_LANG']['MSC']['sEmpty'], \Contao\StringUtil::specialchars($this->query)) ?></p>
        <?php endif; ?>
    </div>
<?php endif; ?>
</div>

<?php if ($this->hasApiKey && $this->typedQuestions): ?>
<script src="<?= \Bluebranch\Chatbot\classes\Asset::url('js/typed-placeholder.js') ?>"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const field = document.querySelector('#chatbot-search-<?= $this->id ?> .chatbot-ask-input');
        if (field && field.value === '') {
            new ChatbotTypedPlaceholder(field, <?= json_encode($this->typedQuestions) ?>).start();
        }
    });
</script>
<?php endif; ?>

<?php if ($this->hasApiKey && $this->voice): ?>
<script src="<?= \Bluebranch\Chatbot\classes\Asset::url('js/chatbot-common.js') ?>"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const container = document.getElementById('chatbot-search-<?= $this->id ?>');
        const form = container ? container.querySelector('.chatbot-search-form') : null;
        const input = form ? form.querySelector('.chatbot-ask-input') : null;
        const button = form ? form.querySelector('.chatbot-voice-btn') : null;

        if (!input || !button || !window.ChatbotVoiceField) return;

        ChatbotVoiceField.attach({
            wrap: input.parentElement,
            form: form,
            input: input,
            button: button,
            maxSeconds: <?= (int) $this->voiceMaxSeconds ?>,
            request: {
                pageId: <?= json_encode((string) $this->pageId, JSON_HEX_TAG | JSON_HEX_AMP) ?>,
                moduleId: <?= (int) $this->moduleId ?>,
                sig: <?= json_encode((string) $this->sig) ?>,
                language: <?= json_encode((string) $this->voiceLanguage, JSON_HEX_TAG | JSON_HEX_AMP) ?>
            },
            strings: <?= json_encode($this->feedbackStrings, JSON_HEX_TAG | JSON_HEX_AMP) ?>,
            // Der erkannte Text startet die Suche wie ein getipptes Stichwort.
            onText: function (text) {
                input.value = text;
                if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
            }
        });
    });
</script>
<?php endif; ?>

<?php if ($this->hasApiKey && $this->query): ?>
<script src="<?= \Bluebranch\Chatbot\classes\Asset::url('js/marked.min.js') ?>"></script>
<script src="<?= \Bluebranch\Chatbot\classes\Asset::url('js/chatbot-common.js') ?>"></script>
<script src="<?= \Bluebranch\Chatbot\classes\Asset::url('js/search.js') ?>"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const chatbot = new ChatbotSearch({
            containerId: 'chatbot-search-<?= $this->id ?>',
            query: <?= json_encode((string) $this->query, JSON_HEX_TAG | JSON_HEX_AMP) ?>,
            language: <?= json_encode((string) $this->language, JSON_HEX_TAG | JSON_HEX_AMP) ?>,
            pageId: <?= json_encode((string) $this->pageId, JSON_HEX_TAG | JSON_HEX_AMP) ?>,
            moduleId: <?= (int) $this->moduleId ?>,
            sig: <?= json_encode((string) $this->sig) ?>,
            feedback: <?= $this->feedback ? 'true' : 'false' ?>,
            strings: <?= json_encode($this->feedbackStrings, JSON_HEX_TAG | JSON_HEX_AMP) ?>
        });
        chatbot.init();
    });
</script>
<?php endif; ?>
<!-- indexer::continue -->