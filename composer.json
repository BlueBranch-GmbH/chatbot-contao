{
  "name": "bluebranch/chatbot",
  "description": "KI-Chatbot, KI-Suche und Spracheingabe für Contao: Besucher tippen oder sprechen, die Antworten stammen ausschließlich aus deinen eigenen Seiten – mit Quellen. Fertiges Design, kostenlose Stufe, Betrieb in Deutschland, DSGVO.",
  "keywords": [
    "contao",
    "chatbot",
    "ai",
    "ki",
    "ai-chatbot",
    "ai-search",
    "site-search",
    "voice-input",
    "speech-to-text",
    "voice-assistant",
    "rag",
    "faq",
    "customer-support",
    "gdpr",
    "dsgvo",
    "privacy",
    "search",
    "suche",
    "assistant"
  ],
  "type": "contao-bundle",
  "license": "MIT",
  "homepage": "https://www.chatbot-dsgvo.de/",
  "authors": [
    {
      "name": "Lukas M. Beck",
      "email": "lb@bluebranch.de",
      "homepage": "https://www.bluebranch.de/"
    }
  ],
  "support": {
    "docs": "https://chatbot.bluebranch.de/anleitung/contao",
    "issues": "https://github.com/BlueBranch-GmbH/chatbot-contao/issues",
    "source": "https://github.com/BlueBranch-GmbH/chatbot-contao"
  },
  "require": {
    "php": "^8.0",
    "contao/core-bundle": "^4.13 || ^5.0",
    "league/html-to-markdown": "^5.0",
    "symfony/http-client": "^5.4 || ^6.0 || ^7.0",
    "smalot/pdfparser": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Bluebranch\\Chatbot\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Bluebranch\\Chatbot\\ContaoManager\\Plugin"
  },
  "suggest": {
    "ext-zip": "Zum Auslesen von DOCX- und ODT-Dateien als Zusatzinhalt"
  }
}
